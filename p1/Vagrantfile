LOGIN = "fnascime"

BOX        = "debian13"
BOX_URL    = "https://github.com/northwindstudios/inception-of-things/releases/download/box-debian-13.7.0/debian-13-virtualbox.box"
BOX_SHA256 = "e8c805aa360c91e0d35cd86dffbd58f0729fba3f43a2aa43f458cb6e9398c6c6"

box_url = ENV.fetch("BOX_URL", BOX_URL)

MACHINES = {
  "#{LOGIN}S"  => { ip: "192.168.56.110", role: "server" },
  "#{LOGIN}SW" => { ip: "192.168.56.111", role: "worker" },
}

Vagrant.configure("2") do |config|
  config.vm.box     = BOX
  config.vm.box_url = box_url

  if box_url == BOX_URL
    config.vm.box_download_checksum      = BOX_SHA256
    config.vm.box_download_checksum_type = "sha256"
  end

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provision "shell", path: "scripts/ssh.sh"

  MACHINES.each do |name, machine|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |v|
        v.name   = name
        v.cpus   = 1
        v.memory = 1024
      end

      node.vm.provision "shell", path: "scripts/#{machine[:role]}.sh"
    end
  end
end
