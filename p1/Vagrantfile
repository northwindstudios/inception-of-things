require "fileutils"
require "securerandom"

LOGIN = "fnascime"

BOX        = "debian13"
BOX_URL    = "https://github.com/northwindstudios/inception-of-things/releases/download/box-debian-13.7.0/debian-13-virtualbox.box"
BOX_SHA256 = "e8c805aa360c91e0d35cd86dffbd58f0729fba3f43a2aa43f458cb6e9398c6c6"

K3S_VERSION = "v1.37.2+k3s1"

box_url = ENV.fetch("BOX_URL", BOX_URL)

TOKEN_FILE = File.join(__dir__, ".vagrant", "k3s-token")

def k3s_token
  return File.read(TOKEN_FILE).strip if File.exist?(TOKEN_FILE)
  return "unused" if (ARGV & %w[up provision reload]).empty?

  token = SecureRandom.hex(32)
  FileUtils.mkdir_p(File.dirname(TOKEN_FILE))
  File.write(TOKEN_FILE, token, perm: 0o600)
  token
end

K3S_TOKEN = k3s_token

MACHINES = {
  "#{LOGIN}S"  => { ip: "192.168.56.110", role: "server", memory: 2048 },
  "#{LOGIN}SW" => { ip: "192.168.56.111", role: "worker", memory: 1024 },
}

SERVER_IP = MACHINES.values.find { |m| m[:role] == "server" }[:ip]

Vagrant.configure("2") do |config|
  config.vm.box     = BOX
  config.vm.box_url = box_url

  if box_url == BOX_URL
    config.vm.box_download_checksum      = BOX_SHA256
    config.vm.box_download_checksum_type = "sha256"
  end

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vagrant.sensitive = [K3S_TOKEN]

  config.vm.provision "shell", path: "scripts/ssh.sh"

  MACHINES.each do |name, machine|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |v|
        v.name   = name
        v.cpus   = 1
        v.memory = machine[:memory]
      end

      node.vm.provision "shell", path: "scripts/#{machine[:role]}.sh",
        env: { "NODE_IP" => machine[:ip], "SERVER_IP" => SERVER_IP, "K3S_VERSION" => K3S_VERSION, "K3S_TOKEN" => K3S_TOKEN }

      if machine[:role] == "server"
        node.vm.provision "shell", path: "scripts/kubectl.sh"

        node.trigger.after :destroy do |t|
          t.name = "Remove the join token"
          t.ruby { |_env, _machine| FileUtils.rm_f(TOKEN_FILE) }
        end
      end
    end
  end
end
